[Unit]
Description=OpenMSAify Paper Trade Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/openmsaify
ExecStart=/usr/bin/python3 /root/openmsaify/daemon.py
Restart=always
RestartSec=10
StandardOutput=append:/root/openmsaify/daemon.log
StandardError=append:/root/openmsaify/daemon.log
Environment=PYTHONPATH=/root/openmsaify

[Install]
WantedBy=multi-user.target
